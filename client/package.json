{
  "name": "lumen-client",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "build": "vite build && vite build -c vite.admin.config.ts && vite build -c vite.guard.config.ts && vite build -c vite.dashboard.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "size": "node scripts/check-size.mjs",
    "guard-hash": "node scripts/guard-csp.mjs"
  },
  "license": "GPL-3.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "preact": "~11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
